# The judge talks to any OpenAI-compatible Chat Completions API. Copy to .env and fill in.
# .env is gitignored — never commit a real key.

OPENAI_API_KEY=sk-your-key-here                 # required

# Default is OpenAI. For another provider, set the base URL and a model id it accepts:
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1   JUDGE_MODEL=openai/gpt-4o-mini
#   Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1 JUDGE_MODEL=llama-3.3-70b-versatile
#   Local:      OPENAI_BASE_URL=http://localhost:11434/v1      JUDGE_MODEL=qwen2.5:7b-instruct
OPENAI_BASE_URL=https://api.openai.com/v1
JUDGE_MODEL=gpt-4o-mini
