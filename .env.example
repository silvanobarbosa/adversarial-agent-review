# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Read a repo for the security judge (a read-only token is enough).
GITHUB_TOKEN=

# Independent judge model — any OpenAI-compatible endpoint. Set ONE of these.
OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Optional model overrides
# OPENROUTER_JUDGE_MODEL=z-ai/glm-4.6
# OPENROUTER_VISION_MODEL=openai/gpt-4o
